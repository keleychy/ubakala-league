# Example environment variables for frontend
# Point to local backend during development:
REACT_APP_API_URL=http://localhost:8000/api

# Or point to production API:
# REACT_APP_API_URL=https://ubakalaunitycup.onrender.com/api

# Firebase Authentication web-app configuration (test project values only).
# These are public client configuration values; never add service-account keys
# or private credentials to frontend environment variables.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# The Apps Script proxy is hosted on the same Vercel project as the frontend.
# Set APPS_SCRIPT_API_URL in Vercel's server-side environment variables if needed.
